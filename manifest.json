{
  "manifest_version": 3,
  "name": "TabMind",
  "version": "1.0.0",
  "description": "A minimalist Chromium extension that organizes your tab chaos using AI. Supports 12+ providers (OpenAI, Claude, Gemini) and local models (Ollama) directly in your browser.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.mistral.ai/*",
    "https://openrouter.ai/*",
    "https://api.x.ai/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.moonshot.cn/*",
    "https://api.together.xyz/*",
    "https://api.perplexity.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TabMind - Organize your tabs with AI"
  },
  "icons": {
    "128": "cover.png"
  },
  "minimum_chrome_version": "88"
}
